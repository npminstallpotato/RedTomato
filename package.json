{
  "name": "@npminstallpotato/redtomato",
  "version": "0.1.0",
  "description": "Programmatic TypeScript wrapper around the Claude Code CLI — call Claude via functions, not the TUI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "wrapper",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npminstallpotato/RedTomato.git"
  },
  "homepage": "https://github.com/npminstallpotato/RedTomato#readme",
  "bugs": {
    "url": "https://github.com/npminstallpotato/RedTomato/issues"
  },
  "author": "npminstallpotato",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "echo 'See test.md for test spec'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
